# Email capture. Without these two, /api/subscribe accepts the signup and logs it.
# Create the group in MailerLite first, then copy its numeric ID.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Stripe Billing. Use a restricted key (rk_test_ / rk_live_) where possible:
# Prices: read, Products: read, Checkout Sessions: write, Subscriptions: write.
# Never commit a real key. Local values belong in .env.local.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the endpoint's signing secret in the Dashboard for production.
STRIPE_WEBHOOK_SECRET=

# Absolute origin used for Checkout success/cancel URLs.
# Production: https://openhousestudio.online
NEXT_PUBLIC_SITE_URL=http://localhost:3000
